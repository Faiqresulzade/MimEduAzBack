{
  "ConnectionStrings": {
    "DefaultConnection": "server=__DB_HOST__;port=3306;database=__DB_NAME__;user=__DB_USER__;password=__DB_PASSWORD__;"
  },
  "Jwt": {
    "Issuer": "https://api.mimedu.az",
    "Audience": "https://mimedu.az",
    "SecretKey": "__SET_VIA_USER_SECRETS_OR_ENV__",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "Commission": {
    "ResourcePercent": 0.20
  },
  "FileStorage": {
    "RootPath": "uploads/resources",
    "MaxFileSizeBytes": 26214400,
    "AllowedExtensions": [ ".pdf", ".docx", ".pptx" ]
  },
  "Cors": {
    "AllowedOrigins": [ "https://mimedu.az" ]
  },
  "RequestLog": {
    "Enabled": true,
    "LogRequestBody": true,
    "LogResponseBody": true,
    "MaxBodyLength": 4000,
    "ExcludedPathPrefixes": [ "/swagger", "/uploads", "/health", "/favicon.ico" ],
    "QueueCapacity": 2000,
    "BatchSize": 50,
    "FlushIntervalSeconds": 5,
    "RetentionDays": 30
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "AllowedHosts": "*"
}
