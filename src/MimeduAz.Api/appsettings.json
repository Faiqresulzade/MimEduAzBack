{
  "ConnectionStrings": {
    "DefaultConnection": "Host=__DB_HOST__;Port=5432;Database=mimedu;Username=__DB_USER__;Password=__DB_PASSWORD__"
  },
  "Jwt": {
    "Issuer": "https://api.mimedu.az",
    "Audience": "https://mimedu.az",
    "SecretKey": "__SET_VIA_USER_SECRETS_OR_ENV__",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "Commission": {
    "ResourcePercent": 0.20
  },
  "FileStorage": {
    "RootPath": "uploads/resources",
    "MaxFileSizeBytes": 26214400,
    "AllowedExtensions": [ ".pdf", ".docx", ".pptx" ]
  },
  "Cors": {
    "AllowedOrigins": [ "https://mimedu.az" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "AllowedHosts": "*"
}
