{
  "ConnectionStrings": {
    "DefaultConnection": "Host=__DB_HOST__;Port=5432;Database=__DB_NAME__;Username=__DB_USER__;Password=__DB_PASSWORD__;SSL Mode=Require;Trust Server Certificate=true"
  },
  "Jwt": {
    "Issuer": "https://api.mimedu.az",
    "Audience": "https://mimedu.az",
    "SecretKey": "__SET_VIA_USER_SECRETS_OR_ENV__",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "Commission": {
    "ResourcePercent": 0.2
  },
  "FileStorage": {
    "RootPath": "uploads/resources",
    "MaxFileSizeBytes": 26214400,
    "AllowedExtensions": [
      ".pdf",
      ".docx",
      ".pptx"
    ]
  },
  "Cors": {
    "AllowedOrigins": [
      "https://mimedu.az"
    ]
  },
  "RequestLog": {
    "Enabled": true,
    "LogRequestBody": true,
    "LogResponseBody": true,
    "MaxBodyLength": 4000,
    "ExcludedPathPrefixes": [
      "/swagger",
      "/uploads",
      "/health",
      "/favicon.ico"
    ],
    "QueueCapacity": 2000,
    "BatchSize": 50,
    "FlushIntervalSeconds": 5,
    "RetentionDays": 30
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "AllowedHosts": "*",
  "Certificate": {
    "VerificationUrlTemplate": "https://mimedu.az/sertifikat-yoxla/{code}",
    "SignatureName": "MIMEDU.AZ",
    "SignatureTitle": "Platforma rəhbərliyi",
    "PngDpi": 150
  }
}
